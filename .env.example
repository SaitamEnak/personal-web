# Server-side only — set these in the Vercel dashboard (Production + Preview).
# For local dev with the real Edge Function: copy to .env.local and fill in the values,
# then run `pnpm exec vercel dev` instead of `pnpm dev`.
# Never add a VITE_ prefix — that would leak the key into the client bundle.
CMS_API_URL=
CMS_API_KEY=
